---
import ProjectCard from "@/components/ProjectCard.astro";
import { featuredProjects } from "@/data/site";
---

<section class="work-section" id="work">
  <div class="shell work-heading" data-reveal>
    <p class="section-kicker">Selected work · 2025–26</p>
    <div class="work-title-row">
      <h2 class="display-heading">
        Work that<br /><span class="serif-accent">earns its keep.</span>
      </h2>
      <p>Tools, systems and experiments built around a real need.</p>
    </div>
  </div>

  <div class="mobile-rail-label shell">
    <span>Swipe or browse</span>
    <div class="rail-controls">
      <button type="button" data-project-prev aria-label="Previous project">←</button>
      <span data-project-count aria-live="polite" aria-atomic="true">01 / {String(featuredProjects.length).padStart(2, "0")}</span>
      <button type="button" data-project-next aria-label="Next project">→</button>
    </div>
  </div>

  <div class="projects-rail" role="region" aria-label="Selected projects">
    <div class="shell projects-grid">
      {
        featuredProjects.map((project) => (
          <ProjectCard project={project} total={featuredProjects.length} />
        ))
      }
    </div>
  </div>
</section>

<script>
  const initializeRail = () => {
    const rail = document.querySelector<HTMLElement>(".projects-rail");
    if (!rail || rail.dataset.ready) return;
    rail.dataset.ready = "true";
    const cards = Array.from(rail.querySelectorAll<HTMLElement>(".project-card"));
    const previous = document.querySelector<HTMLButtonElement>("[data-project-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-project-next]");
    const count = document.querySelector<HTMLElement>("[data-project-count]");
    const selectedIndex = () => {
      const middle = rail.getBoundingClientRect().left + rail.clientWidth / 2;
      return cards.reduce((best, card, index) => {
        const bounds = card.getBoundingClientRect();
        const bestBounds = cards[best].getBoundingClientRect();
        return Math.abs(bounds.left + bounds.width / 2 - middle) < Math.abs(bestBounds.left + bestBounds.width / 2 - middle) ? index : best;
      }, 0);
    };
    const update = () => {
      const index = selectedIndex();
      if (count) count.textContent = `${String(index + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === cards.length - 1;
    };
    const move = (direction: number) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, selectedIndex() + direction))];
      rail.scrollTo({ left: card.offsetLeft - (rail.clientWidth - card.clientWidth) / 2, behavior: "auto" });
      update();
    };
    previous?.addEventListener("click", () => move(-1));
    next?.addEventListener("click", () => move(1));
    rail.addEventListener("scroll", update, { passive: true });
    update();
  };
  document.addEventListener("astro:page-load", initializeRail);
  initializeRail();
</script>

<style>
  .work-section {
    padding: var(--section-space) 0;
    color: var(--cream);
    background: var(--ink);
  }

  .work-heading {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .work-heading .section-kicker {
    margin-bottom: clamp(2rem, 5vw, 5rem);
    color: var(--acid);
  }

  .work-title-row {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 3fr) minmax(17rem, 1fr);
    gap: 3rem;
  }

  .work-title-row h2 {
    max-width: 12ch;
  }

  .work-title-row .serif-accent {
    color: var(--orange);
    font-style: italic;
  }

  .work-title-row > p {
    max-width: 34ch;
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .mobile-rail-label {
    display: none;
  }

  @media (max-width: 920px) {
    .work-title-row {
      display: block;
    }
    .work-title-row > p {
      margin-top: 2rem;
    }
  }

  @media (max-width: 700px) {
    .work-section {
      padding-bottom: 5.5rem;
    }

    .work-heading {
      margin-bottom: 2.4rem;
    }

    .work-title-row > p {
      max-width: 31ch;
      font-size: 0.72rem;
    }

    .mobile-rail-label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.8rem;
      color: var(--acid);
      font-size: 0.55rem;
      text-transform: uppercase;
    }

    .projects-rail {
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
      scroll-padding-inline: var(--page-gutter);
      scroll-snap-type: x mandatory;
    }

    .projects-rail::-webkit-scrollbar {
      display: none;
    }

    .projects-grid {
      display: flex;
      width: max-content;
      margin: 0;
      padding-inline: var(--page-gutter);
      gap: 0.75rem;
    }

    .projects-grid::after {
      width: calc(var(--page-gutter) - 0.75rem);
      flex: 0 0 calc(var(--page-gutter) - 0.75rem);
      content: "";
    }
  }
  .rail-controls { display: flex; align-items: center; gap: 0.8rem; }
  .rail-controls button { width: 2.75rem; height: 2.75rem; border: 1px solid currentColor; border-radius: 50%; color: var(--acid); background: transparent; font-size: 1.1rem; cursor: pointer; }
  .rail-controls button:disabled { opacity: 0.4; cursor: default; }
  .rail-controls span { font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) { .mobile-rail-label { align-items: center; font-size: 0.65rem; } }
</style>
