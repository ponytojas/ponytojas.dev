---
interface Props {
  tags: string[];
  label: string;
}

const { tags, label } = Astro.props;
---

<ul class="tag-list" aria-label={label}>
  {tags.map((tag) => <li>{tag}</li>)}
</ul>

<style>
  .tag-list {
    display: flex;
    align-content: flex-start;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    width: fit-content;
    height: fit-content;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.38rem 0.64rem;
    font-size: 0.57rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
</style>
