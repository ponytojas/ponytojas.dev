---
import TagList from "@/components/ui/TagList.astro";
import type { CareerEntry } from "@/data/site";

interface Props {
  item: CareerEntry;
  index: number;
  expanded?: boolean;
}

const { item, index, expanded = false } = Astro.props;
const panelId = `experience-panel-${index}`;
---

<article class="experience-item" data-open={String(expanded)} data-reveal>
  <button
    class="experience-summary"
    type="button"
    aria-expanded={expanded}
    aria-controls={panelId}
  >
    <span class="experience-index">{String(index + 1).padStart(2, "0")}</span>
    <span class="company-block">
      <span class="experience-company">{item.company}</span>
      <span class="experience-role-mobile">{item.role}</span>
    </span>
    <span class="experience-role">{item.role}</span>
    <span class="experience-time">{item.time}</span>
    <span class="experience-toggle" aria-hidden="true"></span>
  </button>

  <div class="experience-panel" id={panelId} aria-hidden={!expanded}>
    <div class="experience-panel-inner">
      <div class="experience-detail">
        <p>
          {item.summary}
          {
            item.website && (
              <>
                <br />
                <a
                  class="experience-website"
                  href={item.website}
                  target="_blank"
                  rel="noreferrer"
                >
                  Visit website <span aria-hidden="true">↗</span>
                </a>
              </>
            )
          }
        </p>
        <TagList tags={item.tags} label={`${item.company} focus areas`} />
      </div>
    </div>
  </div>
</article>

<style>
  .experience-item {
    border-bottom: 1px solid var(--ink);
  }

  .experience-summary {
    display: grid;
    width: 100%;
    min-height: 6rem;
    align-items: center;
    grid-template-columns: 4rem 2fr 1.4fr 0.8fr 2rem;
    gap: 1rem;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: transparent;
    text-align: left;
  }

  .experience-summary:hover .experience-company,
  .experience-summary[aria-expanded="true"] .experience-company {
    color: var(--orange);
  }

  .experience-index,
  .experience-role,
  .experience-role-mobile,
  .experience-time {
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .company-block {
    display: block;
  }

  .experience-company {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.3vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    transition: color 180ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .experience-role-mobile {
    display: none;
  }

  .experience-time {
    text-align: right;
  }

  .experience-toggle {
    position: relative;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition: color 180ms ease, background 180ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .experience-toggle::before,
  .experience-toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.7rem;
    height: 1px;
    content: "";
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .experience-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .experience-summary[aria-expanded="true"] .experience-toggle {
    background: var(--orange);
    color: var(--cream);
    transform: rotate(180deg);
  }

  .experience-summary[aria-expanded="true"] .experience-toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .experience-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 480ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease;
  }

  .experience-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .experience-item[data-open="true"] .experience-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .experience-detail {
    display: grid;
    grid-template-areas: "copy tags";
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding: 0.25rem 3rem 2.75rem 5rem;
  }

  .experience-detail p {
    grid-area: copy;
    min-width: 0;
    max-width: 62ch;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .experience-detail :global(.tag-list) {
    grid-area: tags;
    min-width: 0;
    align-self: start;
  }

  .experience-website {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.2rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    color: var(--orange-dark);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .experience-website span {
    transition: transform 180ms ease;
  }

  .experience-website:hover span {
    transform: translate(0.18rem, -0.18rem);
  }

  @media (max-width: 850px) {
    .experience-summary {
      min-height: 5.8rem;
      grid-template-columns: 2.2rem minmax(0, 1fr) auto 2rem;
    }

    .experience-role {
      display: none;
    }

    .experience-role-mobile {
      display: block;
      margin-top: 0.4rem;
      color: var(--muted);
      font-size: 0.56rem;
    }

    .experience-detail {
      grid-template-areas:
        "copy"
        "tags";
      grid-template-columns: minmax(0, 1fr);
      gap: 1.3rem;
      padding-left: 3.2rem;
      padding-right: 0;
    }
  }

  @media (max-width: 550px) {
    .experience-summary {
      min-height: 6.2rem;
      grid-template-columns: minmax(0, 1fr) auto 2rem;
      gap: 0.65rem;
    }

    .experience-index {
      display: none;
    }

    .experience-company {
      font-size: 1.25rem;
      line-height: 0.95;
    }

    .experience-time {
      align-self: start;
      padding-top: 1.55rem;
      font-size: 0.52rem;
      white-space: nowrap;
    }

    .experience-detail {
      display: block;
      padding: 0 0 2.2rem;
    }

    .experience-detail p {
      font-size: 0.74rem;
      line-height: 1.65;
    }

    .experience-detail :global(.tag-list) {
      margin-top: 1.3rem;
    }
  }
</style>
