---
import type { BlogPost } from "@/data/blog";
import { formatDate } from "@/lib/formatDate";

interface Props {
  post: BlogPost;
  index: number;
}

const { post, index } = Astro.props;
---

<a class="note-card" href={`/notes/${post.slug}`} data-reveal>
  <div class="note-top">
    <span>{String(index + 1).padStart(2, "0")}</span>
    <span>{formatDate(post.date)}</span>
    <span>{post.readTime}</span>
  </div>

  <div class="note-title-block">
    <span class="note-watermark" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
    <h3>{post.title}</h3>
  </div>

  <p>{post.excerpt}</p>

  <div class="note-bottom">
    <ul aria-label="Topics">
      {post.tags?.map((tag) => <li>{tag}</li>)}
    </ul>
    <span class="note-arrow" aria-hidden="true">↗</span>
  </div>
</a>

<style>
  .note-card {
    position: relative;
    display: grid;
    min-height: 34rem;
    padding: clamp(1.2rem, 2.6vw, 2.5rem);
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    grid-template-rows: auto 1fr auto auto;
    overflow: hidden;
    transition: background 300ms ease, color 300ms ease;
  }

  .note-card:hover {
    color: var(--cream);
    background: var(--blue);
  }

  .note-top {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding-bottom: 1rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .note-top span:nth-child(2) { text-align: center; }
  .note-top span:last-child { text-align: right; }

  .note-title-block {
    position: relative;
    display: flex;
    align-items: center;
  }

  h3 {
    position: relative;
    z-index: 1;
    max-width: 14ch;
    margin: clamp(2.5rem, 6vw, 6rem) 0 2rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.8rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .note-watermark {
    position: absolute;
    right: -1.5rem;
    color: currentColor;
    font-family: var(--font-display);
    font-size: clamp(8rem, 16vw, 15rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 1;
    opacity: 0.06;
    transform: rotate(6deg);
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .note-card:hover .note-watermark { transform: rotate(0deg) scale(1.08); }

  .note-card > p {
    position: relative;
    z-index: 1;
    max-width: 50ch;
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .note-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
  }

  .note-bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    font-size: 0.58rem;
    list-style: none;
    text-transform: uppercase;
  }

  .note-bottom li:not(:last-child)::after {
    margin-left: 1rem;
    content: "/";
  }

  .note-arrow {
    display: grid;
    width: 3.2rem;
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1.45rem;
    line-height: 1;
    transition: transform 220ms ease, background 220ms ease, color 220ms ease;
  }

  .note-card:hover .note-arrow {
    background: var(--acid);
    color: var(--ink);
    transform: rotate(8deg);
  }

  @media (max-width: 800px) {
    .note-card {
      min-height: 27rem;
    }

    h3 {
      max-width: 13ch;
      margin: 2.6rem 0 1.5rem;
      font-size: clamp(2.25rem, 10.5vw, 3.5rem);
    }

    .note-card > p {
      display: -webkit-box;
      overflow: hidden;
      font-size: 0.68rem;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .note-watermark {
      right: -0.5rem;
      font-size: 10rem;
    }
  }
</style>
