---
import { ArrowUpRight } from "lucide-react";
---

<footer class="contact-section" id="contact">
  <div class="shell contact-shell">
    <div class="contact-top">
      <p class="section-kicker">Have a useful problem?</p>
      <p>Available for thoughtful conversations<br />and interesting collaborations.</p>
    </div>

    <a class="contact-email" href="mailto:daniel.villalobosdel@icloud.com" data-reveal>
      <span>LET&apos;S</span>
      <span class="serif-accent">make it work.</span>
      <i aria-hidden="true">
        <ArrowUpRight strokeWidth={1.8} />
      </i>
    </a>

    <div class="contact-bottom">
      <p>Spain · Remote friendly</p>
      <div class="social-links">
        <a href="https://github.com/ponytojas" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/ponytojas/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href="/cv-danielVillalobos.pdf" target="_blank" rel="noreferrer">CV ↗</a>
      </div>
      <p>© <span data-year>2026</span> Dani Villalobos</p>
    </div>
  </div>
</footer>

<style>
  .contact-section {
    min-height: 80svh;
    padding: clamp(3rem, 6vw, 6rem) 0 1.5rem;
    color: var(--cream);
    background: var(--ink);
  }

  .contact-shell {
    display: flex;
    min-height: calc(80svh - clamp(4.5rem, 8vw, 7.5rem));
    flex-direction: column;
  }

  .contact-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 2rem;
  }

  .contact-top .section-kicker {
    color: var(--acid);
  }

  .contact-top > p:last-child {
    margin: 0;
    font-size: 0.68rem;
    line-height: 1.6;
    text-align: right;
    text-transform: uppercase;
  }

  .contact-email {
    position: relative;
    display: flex;
    margin: auto 0;
    padding: 2rem 0;
    flex-direction: column;
    border-top: 1px solid rgba(242, 238, 227, 0.35);
    border-bottom: 1px solid rgba(242, 238, 227, 0.35);
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 13rem);
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.72;
  }

  .contact-email .serif-accent {
    align-self: end;
    color: var(--orange);
    font-style: italic;
  }

  .contact-email i {
    position: absolute;
    top: 50%;
    right: 50%;
    display: grid;
    width: clamp(4rem, 8vw, 8rem);
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--acid);
    color: var(--ink);
    font-style: normal;
    transform: translate(50%, -50%) rotate(-8deg);
    transition: transform 250ms ease;
  }

  .contact-email i :global(svg) {
    width: 42%;
    height: 42%;
  }

  .contact-email:hover i {
    transform: translate(50%, -50%) rotate(8deg) scale(1.08);
  }

  .contact-bottom {
    display: grid;
    align-items: end;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    padding-top: 1.5rem;
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .contact-bottom p {
    margin: 0;
  }

  .contact-bottom p:last-child {
    text-align: right;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a:hover {
    color: var(--acid);
  }

  @media (max-width: 700px) {
    .contact-section,
    .contact-shell {
      min-height: 70svh;
    }

    .contact-top > p:last-child {
      display: none;
    }

    .contact-email {
      font-size: clamp(3.7rem, 18vw, 7rem);
      line-height: 0.8;
    }

    .contact-email .serif-accent {
      align-self: start;
    }

    .contact-email i {
      right: 15%;
    }

    .contact-bottom {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .social-links {
      flex-wrap: wrap;
    }

    .contact-bottom p:last-child {
      text-align: left;
    }
  }
</style>
