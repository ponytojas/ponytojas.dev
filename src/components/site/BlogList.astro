---
import { formatDate } from "@/lib/formatDate";

type BlogListPost = {
  slug: string;
  title: string;
  date: string;
  excerpt: string;
  readTime: string;
  tags?: string[];
};

interface Props {
  posts: BlogListPost[];
}

const { posts } = Astro.props;
---

<div class="index-list border-t border-border">
  {
    posts.map((post) => (
      <article class="index-row border-b border-border">
        <a href={`/blog/${post.slug}`} class="group block py-10 md:py-12">
          <div class="grid grid-cols-1 md:grid-cols-[10rem_1fr_auto] gap-4 md:gap-10 items-baseline">
            <time class="meta-label tabular-nums" datetime={post.date}>
              {formatDate(post.date)}
            </time>

            <div class="min-w-0">
              <h3 class="display-type text-2xl md:text-4xl text-balance group-hover:text-accent transition-colors">
                {post.title}
              </h3>
              <p class="mt-3 max-w-2xl text-muted-foreground text-pretty">{post.excerpt}</p>
              {
                post.tags && post.tags.length > 0 ? (
                  <p class="meta-label mt-4">{post.tags.join(" · ")}</p>
                ) : null
              }
            </div>

            <div class="hidden md:flex items-center gap-4">
              <span class="meta-label tabular-nums">{post.readTime}</span>
              <span class="row-arrow text-2xl" aria-hidden="true">
                &rarr;
              </span>
            </div>
          </div>
        </a>
      </article>
    ))
  }
</div>
