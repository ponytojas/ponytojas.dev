---
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-24">
  <div class="container-custom py-20 md:py-28">
    <p class="meta-label mb-8">Get in touch</p>

    <h2 class="display-type text-[clamp(2.5rem,8vw,7rem)]">
      Let&apos;s build <span class="serif-accent text-accent">something</span> that lasts
    </h2>

    <a
      href="mailto:daniel.villalobosdel@icloud.com?subject=Saw%20your%20website.%20Let's%20talk!"
      class="link-subtle mt-10 inline-block text-lg md:text-2xl text-foreground"
    >
      daniel.villalobosdel@icloud.com
    </a>

    <div class="mt-16 md:mt-24 flex flex-col md:flex-row md:items-end justify-between gap-8 border-t border-border pt-8">
      <nav class="flex items-center gap-7" aria-label="Social">
        <a
          href="https://github.com/ponytojas"
          target="_blank"
          rel="noopener noreferrer"
          class="link-line meta-label hover:text-foreground transition-colors"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/ponytojas/"
          target="_blank"
          rel="noopener noreferrer"
          class="link-line meta-label hover:text-foreground transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="/cv-danielVillalobos.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="link-line meta-label hover:text-foreground transition-colors"
        >
          CV
        </a>
      </nav>

      <div class="flex flex-col md:items-end gap-1">
        <p class="meta-label">&copy; {year} Daniel Villalobos</p>
        <p class="meta-label">Software engineer, Spain</p>
      </div>
    </div>
  </div>
</footer>
