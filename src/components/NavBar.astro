---
const navItems = [
  { label: "Work", href: "#work" },
  { label: "Experience", href: "#experience" },
  { label: "Notes", href: "#notes" },
  { label: "About", href: "#about" },
];
---

<header class="site-header">
  <nav class="shell nav-shell" aria-label="Primary navigation">
    <a class="wordmark" href="#top" aria-label="Daniel Villalobos, back to top">Daniel Villalobos</a>
    <div class="nav-menu-items desktop-links">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <a class="nav-contact" href="mailto:daniel.villalobosdel@icloud.com">
      <span class="status-dot" aria-hidden="true"></span>Let&apos;s talk <span aria-hidden="true">↗</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation">
      <span></span><span></span>
    </button>
  </nav>
  <dialog class="mobile-menu" id="mobile-menu" aria-labelledby="menu-heading">
    <div class="menu-heading">
      <span id="menu-heading">Explore</span>
      <button class="menu-close" type="button" aria-label="Close navigation">×</button>
    </div>
    <nav aria-label="Mobile navigation">
      {navItems.map((item, index) => <a href={item.href}><span>{item.label}</span><small>{String(index + 1).padStart(2, "0")}</small></a>)}
    </nav>
    <div class="mobile-menu-footer">
      <span>Spain · Remote friendly</span>
      <a href="mailto:daniel.villalobosdel@icloud.com">Start a conversation ↗</a>
    </div>
  </dialog>
  <noscript>
    <nav class="shell fallback-nav" aria-label="Section navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </noscript>
</header>

<script>
  const initializeMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
    if (!toggle || !menu || toggle.dataset.ready) return;
    toggle.dataset.ready = "true";
    toggle.addEventListener("click", () => {
      menu.showModal();
      toggle.setAttribute("aria-expanded", "true");
      document.body.classList.add("menu-open");
    });
    menu.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      document.body.classList.remove("menu-open");
    });
    menu.querySelector(".menu-close")?.addEventListener("click", () => menu.close());
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.close()));
    const desktop = window.matchMedia("(min-width: 801px)");
    const resize = () => { if (desktop.matches && menu.open) menu.close(); };
    desktop.addEventListener("change", resize);
    document.addEventListener("astro:before-swap", () => {
      menu.close();
      desktop.removeEventListener("change", resize);
    }, { once: true });
  };
  document.addEventListener("astro:page-load", initializeMenu);
  initializeMenu();
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    color: var(--ink);
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .nav-shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--header-height);
  }
  .wordmark, .nav-menu-items, .nav-contact {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .wordmark { justify-self: start; }
  .nav-menu-items { display: flex; align-items: center; gap: clamp(1.3rem, 3vw, 3.2rem); }
  .nav-menu-items a, .wordmark, .nav-contact { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .nav-menu-items a:hover, .nav-menu-items a:focus-visible { color: var(--orange-dark); }
  .nav-contact { justify-self: end; gap: 0.55rem; }
  .status-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--orange); }
  .nav-toggle, .menu-close {
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.34rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .nav-toggle { display: none; justify-self: end; }
  .nav-toggle span { width: 1rem; height: 1px; background: currentColor; }
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: max(1rem, env(safe-area-inset-top)) max(var(--page-gutter), env(safe-area-inset-right)) max(2rem, env(safe-area-inset-bottom)) max(var(--page-gutter), env(safe-area-inset-left));
    color: var(--ink);
    background: var(--acid);
    overflow-y: auto;
  }
  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
    animation: menu-fade-in 260ms ease both, menu-slide-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .mobile-menu[open] nav a {
    animation: menu-link-enter 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes menu-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes menu-slide-in { from { transform: translateY(-1.5rem); } to { transform: translateY(0); } }
  @keyframes menu-link-enter { from { transform: translateY(-0.8rem); } to { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu[open], .mobile-menu[open] nav a { animation: none; }
  }
  .menu-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 3rem; font-size: 0.72rem; text-transform: uppercase; }
  .menu-close { display: flex; font-size: 1.5rem; }
  .mobile-menu nav { border-top: 1px solid var(--ink); }
  .mobile-menu nav a { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--ink); font-family: var(--font-display); font-size: clamp(2rem, 10vw, 3.2rem); font-weight: 900; text-transform: uppercase; }
  .mobile-menu nav small { font-family: var(--font-mono); font-size: 0.7rem; }
  .mobile-menu-footer { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 2rem; font-size: 0.72rem; line-height: 1.6; }
  .mobile-menu-footer a { max-width: 15ch; font-weight: 700; text-align: right; }
  .fallback-nav { display: flex; justify-content: space-between; padding-block: 1rem; font-size: 0.7rem; }
  @media (max-width: 800px) {
    :global(body.menu-open) { overflow: hidden; }
    .nav-shell { grid-template-columns: 1fr auto; }
    .desktop-links, .nav-contact { display: none; }
    .nav-toggle { display: flex; }
  }
</style>
