---
const navItems = [
  { label: "Work", href: "#work" },
  { label: "Experience", href: "#experience" },
  { label: "Notes", href: "#notes" },
  { label: "About", href: "#about" },
];
---

<header class="site-header">
  <nav class="shell nav-shell" aria-label="Primary navigation">
    <a class="wordmark" href="#top" aria-label="Daniel Villalobos, back to top">
      <span>Daniel Villalobos</span>
    </a>

    <div class="nav-links" id="nav-links">
      <div class="nav-menu-items">
        {
          navItems.map((item, index) => (
            <a href={item.href} data-index={String(index + 1).padStart(2, "0")}>
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="mobile-menu-footer">
        <span>Spain · Remote friendly</span>
        <a href="mailto:daniel.villalobosdel@icloud.com"
          >Start a conversation ↗</a
        >
      </div>
    </div>

    <a class="nav-contact" href="mailto:daniel.villalobosdel@icloud.com">
      <span class="status-dot" aria-hidden="true"></span>
      Let&apos;s talk
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Toggle navigation"
    >
      <span></span><span></span>
    </button>
  </nav>
</header>

<script>
  const closeMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const links = document.querySelector<HTMLElement>("#nav-links");
    toggle?.setAttribute("aria-expanded", "false");
    links?.classList.remove("is-open");
    document.body.classList.remove("menu-open");
  };

  const initializeMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const links = document.querySelector<HTMLElement>("#nav-links");
    if (!toggle || !links || toggle.dataset.ready === "true") return;

    toggle.dataset.ready = "true";
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      links.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("menu-open", !isOpen);
    });

    links
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", closeMenu));
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
  document.addEventListener("astro:page-load", initializeMenu);

  window
    .matchMedia("(min-width: 801px)")
    .addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    color: var(--ink);
    background: var(--cream);
    box-shadow: 0 1px 0 0 var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }

  .nav-shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 5.5rem;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.7rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .nav-links {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .nav-menu-items {
    display: flex;
    align-items: center;
    gap: clamp(1.3rem, 3vw, 3.2rem);
  }

  .nav-menu-items a,
  .nav-contact {
    position: relative;
  }

  .nav-menu-items a::after,
  .nav-contact::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    content: "";
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .nav-menu-items a:hover::after,
  .nav-contact:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-contact {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.55rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .mobile-menu-footer {
    display: none;
  }

  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 0 rgba(243, 75, 36, 0.5);
    animation: status-pulse 2.4s infinite;
  }

  .nav-toggle {
    display: none;
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.34rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: transparent;
  }

  .nav-toggle span {
    width: 1rem;
    height: 1px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .nav-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(0.2rem) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-0.2rem) rotate(-45deg);
  }

  @keyframes status-pulse {
    70% {
      box-shadow: 0 0 0 0.5rem rgba(243, 75, 36, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(243, 75, 36, 0);
    }
  }

  @media (max-width: 800px) {
    :global(body.menu-open) {
      overflow: hidden;
    }

    .nav-shell {
      position: relative;
      grid-template-columns: 1fr auto;
    }

    .wordmark,
    .nav-toggle {
      z-index: 3;
    }

    .nav-contact {
      display: none;
    }

    .nav-toggle {
      display: flex;
      justify-self: end;
    }

    .nav-links {
      position: fixed;
      z-index: 2;
      inset: 0;
      display: flex;
      padding: calc(7.5rem + env(safe-area-inset-top, 0px))
        max(var(--page-gutter), env(safe-area-inset-right, 0px))
        max(2rem, env(safe-area-inset-bottom, 0px))
        max(var(--page-gutter), env(safe-area-inset-left, 0px));
      flex-direction: column;
      background: var(--acid);
      opacity: 0;
      transform: translateY(-1.5rem);
      visibility: hidden;
      transition:
        opacity 260ms ease,
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s linear 420ms;
    }

    .nav-links.is-open {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      transition-delay: 0s;
    }

    .nav-menu-items {
      display: flex;
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--ink);
    }

    .nav-menu-items a {
      display: flex;
      min-height: 4.8rem;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--ink);
      font-family: var(--font-display);
      font-size: clamp(2rem, 10vw, 3.2rem);
      font-weight: 900;
      letter-spacing: -0.06em;
      line-height: 1;
      text-transform: uppercase;
      transform: translateY(-0.8rem);
      transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-links.is-open .nav-menu-items a {
      transform: translateY(0);
    }

    .nav-menu-items a::before {
      order: 2;
      font-family: var(--font-mono);
      font-size: 0.55rem;
      font-weight: 400;
      letter-spacing: 0;
      content: attr(data-index);
    }

    .nav-menu-items a::after {
      display: none;
    }

    .mobile-menu-footer {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
      margin-top: auto;
      font-size: 0.56rem;
      line-height: 1.5;
    }

    .mobile-menu-footer a {
      max-width: 15ch;
      font-weight: 700;
      text-align: right;
    }
  }
</style>
