---
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dani Villalobos",
  description = "Software engineer building internal tools, mobility systems and visual interfaces.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
