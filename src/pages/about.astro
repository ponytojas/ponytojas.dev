---
import SiteLayout from "@/layouts/SiteLayout.astro";
import AboutContent from "@/app/about/about.mdx";
---

<SiteLayout title="About | Daniel Villalobos" description="About Daniel Villalobos">
  <div class="py-16 md:py-24">
    <header class="container-custom mb-12 md:mb-20">
      <p class="meta-label mb-6 text-reveal" data-text-reveal>About</p>
      <h1
        class="display-type text-[clamp(3rem,9vw,8rem)] text-reveal"
        style="--reveal-delay: 80ms;"
        data-text-reveal
      >
        A bit <span class="serif-accent text-accent">about me</span>
      </h1>
    </header>

    <div class="container-custom">
      <div class="border-t border-border pt-12 md:pt-16">
        <div class="prose prose-lg max-w-3xl">
          <AboutContent client:load />
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
