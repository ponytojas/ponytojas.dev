---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { projects } from "@/data/projects";
import LabtoolsProject from "@/app/projects/labtools.mdx";
import DiunProject from "@/app/projects/diun.mdx";
import FlappyBallProject from "@/app/projects/flappy-ball.mdx";
import MyTasksProject from "@/app/projects/my-tasks.mdx";
---

<SiteLayout title="Projects | Daniel Villalobos" description="Projects by Daniel Villalobos">
  <div class="py-16 md:py-24">
    <header class="container-custom mb-12 md:mb-20">
      <p class="meta-label mb-6 text-reveal" data-text-reveal>Projects</p>
      <h1
        class="display-type text-[clamp(3rem,9vw,8rem)] text-reveal"
        style="--reveal-delay: 80ms;"
        data-text-reveal
      >
        Things I&apos;ve <span class="serif-accent text-accent">built</span>
      </h1>
    </header>

    <div class="container-custom">
      <div class="index-list border-t border-border">
        {
          projects.map((project, index) => {
            const { metadata } = project;
            const number = String(index + 1).padStart(2, "0");

            return (
              <details class="collapsible index-row border-b border-border">
                <summary class="cursor-pointer list-none py-7 md:py-9">
                  <div class="grid grid-cols-1 md:grid-cols-[10rem_1fr_auto] gap-2 md:gap-10 items-baseline">
                    <span class="meta-label tabular-nums">{number}</span>

                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 min-w-0">
                      <h2 class="display-type text-2xl md:text-4xl">{metadata.title}</h2>
                      {metadata.subtitle ? (
                        <p class="serif-accent text-lg md:text-xl text-muted-foreground">{metadata.subtitle}</p>
                      ) : null}
                    </div>

                    <span class="collapse-icon justify-self-end text-2xl text-accent" aria-hidden="true">
                      +
                    </span>
                  </div>
                </summary>

                <div class="collapse-panel">
                  <div class="collapse-panel-inner grid grid-cols-1 md:grid-cols-[10rem_1fr] gap-2 md:gap-10 pb-10">
                    <div>{metadata.type ? <p class="meta-label">{metadata.type}</p> : null}</div>

                    <div class="flex flex-col gap-6 max-w-3xl">
                      {metadata.tags && metadata.tags.length > 0 ? (
                        <p class="meta-label">
                          {metadata.tags.map((tag) => tag.technology).join(" · ")}
                        </p>
                      ) : null}

                      <div class="prose max-w-none">
                        {project.id === "labtools" ? <LabtoolsProject client:load /> : null}
                        {project.id === "diun" ? <DiunProject client:load /> : null}
                        {project.id === "flappy-ball" ? <FlappyBallProject client:load /> : null}
                        {project.id === "my-tasks" ? <MyTasksProject client:load /> : null}
                      </div>

                      {metadata.link ? (
                        <a
                          href={metadata.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-line meta-label w-fit hover:text-foreground transition-colors"
                        >
                          View project &nearr;
                        </a>
                      ) : null}
                    </div>
                  </div>
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </div>
</SiteLayout>
