---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllBlogPosts, type BlogPost } from "@/data/blog";
import { formatDate } from "@/lib/formatDate";

export function getStaticPaths() {
  return getAllBlogPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Component } = post;
---

<BaseLayout title={`${post.title} — Daniel Villalobos`} description={post.excerpt}>
  <header class="note-nav shell">
    <a href="/" aria-label="Back to Daniel Villalobos home">Daniel Villalobos</a>
    <a href="/#notes">← All notes</a>
  </header>

  <main class="note-page">
    <header class="note-hero shell">
      <div class="note-meta">
        <span>{formatDate(post.date)}</span>
        <span>{post.readTime}</span>
        <span>Note</span>
      </div>
      <h1>{post.title}</h1>
      <p>{post.excerpt}</p>
    </header>

    <div class="note-rule" aria-hidden="true">
      <span>Read slowly · Keep the useful parts · Question the rest ·</span>
    </div>

    <article class="note-content shell prose">
      <Component />
    </article>
  </main>

  <footer class="note-footer shell">
    <p>Thanks for reading.</p>
    <a href="mailto:daniel.villalobosdel@icloud.com">Discuss this note ↗</a>
  </footer>
</BaseLayout>

<style>
  :global(body) {
    background: var(--cream);
  }

  .note-nav {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--ink);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .note-nav a:first-child {
    letter-spacing: 0.02em;
  }

  .note-hero {
    padding-top: clamp(3rem, 8vw, 8rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
  }

  .note-meta {
    display: flex;
    gap: 1.5rem;
    color: var(--orange-dark);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .note-hero h1 {
    max-width: 14ch;
    margin: clamp(2rem, 5vw, 5rem) 0 2rem;
    font-family: var(--font-display);
    font-size: clamp(3.7rem, 9.5vw, 9.5rem);
    font-weight: 900;
    letter-spacing: -0.078em;
    line-height: 0.84;
  }

  .note-hero > p {
    max-width: 52ch;
    margin: 0 0 0 auto;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.3vw, 2rem);
    line-height: 1.15;
  }

  .note-rule {
    display: flex;
    min-height: 3.2rem;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--acid);
    font-size: 0.63rem;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .note-rule span {
    margin-left: var(--page-gutter);
  }

  .note-content {
    max-width: 48rem;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 10vw, 10rem);
  }

  .note-content :global(p),
  .note-content :global(li) {
    font-family: Georgia, serif;
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    line-height: 1.75;
  }

  .note-content :global(p) {
    margin: 0 0 1.7em;
  }

  .note-content :global(blockquote) {
    margin: 0 0 2.5rem;
    padding-left: 1.5rem;
    border-left: 0.35rem solid var(--orange);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .note-content :global(blockquote p) {
    font: inherit;
    line-height: inherit;
  }

  .note-content :global(strong) {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.12em;
  }

  .note-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--ink);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .note-footer p { margin: 0; }

  @media (max-width: 650px) {
    .note-hero h1 {
      font-size: clamp(3.4rem, 16vw, 5.2rem);
    }

    .note-meta {
      flex-wrap: wrap;
    }

    .note-content :global(p),
    .note-content :global(li) {
      font-size: 1.08rem;
    }
  }
</style>
