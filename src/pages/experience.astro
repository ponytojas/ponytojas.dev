---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { experiences } from "@/data/experiences";
---

<SiteLayout title="Experience | Daniel Villalobos" description="Experience of Daniel Villalobos">
  <div class="py-16 md:py-24">
    <header class="container-custom mb-12 md:mb-20">
      <p class="meta-label mb-6 text-reveal" data-text-reveal>Experience</p>
      <h1
        class="display-type text-[clamp(3rem,9vw,8rem)] text-reveal"
        style="--reveal-delay: 80ms;"
        data-text-reveal
      >
        Where I&apos;ve <span class="serif-accent text-accent">worked</span>
      </h1>
    </header>

    <div class="container-custom">
      <div class="index-list border-t border-border">
        {
          experiences.map((experience) => {
            const Component = experience.Component;
            const { metadata } = experience;

            return (
              <details class="collapsible index-row border-b border-border">
                <summary class="cursor-pointer list-none py-7 md:py-9">
                  <div class="grid grid-cols-1 md:grid-cols-[10rem_1fr_auto] gap-2 md:gap-10 items-baseline">
                    <span class="meta-label tabular-nums">{metadata.time}</span>

                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 min-w-0">
                      <h2 class="display-type text-2xl md:text-4xl">{metadata.title}</h2>
                      <p class="serif-accent text-lg md:text-xl text-muted-foreground">{metadata.position}</p>
                    </div>

                    <span class="collapse-icon justify-self-end text-2xl text-accent" aria-hidden="true">
                      +
                    </span>
                  </div>
                </summary>

                <div class="collapse-panel">
                  <div class="collapse-panel-inner grid grid-cols-1 md:grid-cols-[10rem_1fr] gap-2 md:gap-10 pb-10">
                    <div>
                      {metadata.link ? (
                        <a
                          href={metadata.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-line meta-label hover:text-foreground transition-colors"
                        >
                          Visit site &nearr;
                        </a>
                      ) : null}
                    </div>

                    <div class="flex flex-col gap-6 max-w-3xl">
                      {metadata.tags && metadata.tags.length > 0 ? (
                        <p class="meta-label">
                          {metadata.tags.map((tag) => tag.technology).join(" · ")}
                        </p>
                      ) : null}

                      <div class="prose max-w-none">
                        <Component />
                      </div>
                    </div>
                  </div>
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </div>
</SiteLayout>
