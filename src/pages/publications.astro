---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { publications } from "@/data/publications";
---

<SiteLayout title="Publications | Daniel Villalobos" description="Publications by Daniel Villalobos">
  <div class="py-16 md:py-24">
    <header class="container-custom mb-12 md:mb-20">
      <p class="meta-label mb-6 text-reveal" data-text-reveal>Publications</p>
      <h1
        class="display-type text-[clamp(3rem,9vw,8rem)] text-reveal"
        style="--reveal-delay: 80ms;"
        data-text-reveal
      >
        Research &amp; <span class="serif-accent text-accent">papers</span>
      </h1>
    </header>

    <div class="container-custom">
      <div class="index-list border-t border-border">
        {
          publications.map((publication) => {
            const Content = publication.Content;
            const { metadata } = publication;

            return (
              <details class="collapsible index-row border-b border-border">
                <summary class="cursor-pointer list-none py-7 md:py-9">
                  <div class="grid grid-cols-1 md:grid-cols-[10rem_1fr_auto] gap-2 md:gap-10 items-baseline">
                    <span class="meta-label tabular-nums">{metadata.time}</span>
                    <h2 class="display-type text-2xl md:text-4xl text-balance">{metadata.title}</h2>
                    <span class="collapse-icon justify-self-end text-2xl text-accent" aria-hidden="true">
                      +
                    </span>
                  </div>
                </summary>

                <div class="collapse-panel">
                  <div class="collapse-panel-inner grid grid-cols-1 md:grid-cols-[10rem_1fr] gap-2 md:gap-10 pb-10">
                    <div />
                    <div class="flex flex-col gap-6 max-w-3xl">
                      <div class="prose max-w-none">
                        <Content />
                      </div>

                      {metadata.link ? (
                        <a
                          href={metadata.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-line meta-label w-fit hover:text-foreground transition-colors"
                        >
                          Read publication &nearr;
                        </a>
                      ) : null}
                    </div>
                  </div>
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </div>
</SiteLayout>
