---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagList from "@/components/ui/TagList.astro";
import { projects } from "@/data/projects";
import { featuredProjects } from "@/data/site";

export function getStaticPaths() {
  return featuredProjects.map((project) => ({ params: { slug: project.slug } }));
}

const slug = Astro.params.slug ?? "";
const project = featuredProjects.find((item) => item.slug === slug);
const detail = projects.find((item) => item.id === slug);

if (!project || !detail) {
  return Astro.redirect("/#work");
}

const currentIndex = featuredProjects.findIndex((item) => item.slug === slug);
const nextProject = featuredProjects[(currentIndex + 1) % featuredProjects.length];
const Content = detail.Content;
---

<BaseLayout title={`${project.title} — Dani Villalobos`} description={project.description}>
  <header class:list={["case-header", `tone-${project.tone}`]}>
    <nav class="shell case-nav" aria-label="Project navigation">
      <a class="case-home" href="/" aria-label="Dani Villalobos home">DV</a>
      <a href="/#work">← Selected work</a>
      <span>{project.number} / {String(featuredProjects.length).padStart(2, "0")}</span>
    </nav>

    <div class="shell case-hero">
      <div class="case-meta">
        <span>{project.category}</span>
        <span>{project.year}</span>
      </div>

      <h1>{project.title}</h1>

      <div class="case-intro">
        <p>{project.description}</p>
        <TagList tags={project.tags} label={`${project.title} technologies`} />
        {project.href && (
          <a class="case-external" href={project.href} target="_blank" rel="noreferrer">
            {project.cta} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>

      <div class="case-cover">
        <div class="case-cover-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <small>{project.slug}.dev</small>
        </div>
        <img src={project.image} alt={project.imageAlt} />
      </div>
    </div>
  </header>

  <main class="case-main">
    <div class="shell case-layout">
      <aside class="case-rail">
        <span>Case study</span>
        <strong>{project.number}</strong>
        <p>Read time<br />~6 minutes</p>
      </aside>

      <article class="project-prose">
        <Content />
      </article>
    </div>

    <a class:list={["next-project", `tone-${nextProject.tone}`]} href={`/work/${nextProject.slug}`}>
      <div class="shell next-project-inner">
        <span>Next project · {nextProject.number}</span>
        <strong>{nextProject.title}</strong>
        <i aria-hidden="true">→</i>
      </div>
    </a>
  </main>

  <footer class="case-footer shell">
    <span>© <span data-year>2026</span> Dani Villalobos</span>
    <a href="mailto:daniel.villalobosdel@icloud.com">Discuss this project ↗</a>
  </footer>
</BaseLayout>

<style>
  :global(body) {
    background: var(--cream);
  }

  .tone-cream { --case-bg: var(--cream); --case-fg: var(--ink); }
  .tone-orange { --case-bg: var(--orange); --case-fg: var(--ink); }
  .tone-acid { --case-bg: var(--acid); --case-fg: var(--ink); }
  .tone-blue { --case-bg: var(--blue); --case-fg: var(--cream); }

  .case-header {
    padding-bottom: clamp(3rem, 7vw, 7rem);
    color: var(--case-fg);
    background: var(--case-bg);
  }

  .case-nav {
    display: grid;
    min-height: 5.5rem;
    align-items: center;
    grid-template-columns: 1fr auto 1fr;
    border-bottom: 1px solid currentColor;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .case-nav > span {
    justify-self: end;
  }

  .case-home {
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--case-fg);
    color: var(--case-bg);
  }

  .case-hero {
    padding-top: clamp(2.5rem, 6vw, 6rem);
  }

  .case-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: clamp(2rem, 5vw, 5rem) 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 12vw, 12rem);
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.78;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .case-intro {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(18rem, 1.4fr) 1fr auto;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .case-intro > p {
    max-width: 46ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.3vw, 2.15rem);
    line-height: 1.12;
  }

  .case-external {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .case-cover {
    border: 1px solid var(--ink);
    background: #f7f4ec;
    color: var(--ink);
  }

  .case-cover-bar {
    display: flex;
    height: 2.7rem;
    align-items: center;
    gap: 0.45rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .case-cover-bar span {
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .case-cover-bar small {
    margin-left: auto;
    font-size: 0.55rem;
  }

  .case-cover img {
    width: 100%;
    max-height: 48rem;
    object-fit: cover;
    object-position: top center;
  }

  .case-main {
    background: var(--cream);
  }

  .case-layout {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(5rem, 12vw, 12rem);
  }

  .case-rail {
    position: sticky;
    top: 2rem;
    display: flex;
    min-height: 18rem;
    padding: 1rem 0;
    flex-direction: column;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .case-rail strong {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 8rem);
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .case-rail p {
    margin: auto 0 0;
    line-height: 1.5;
  }

  .project-prose {
    width: min(100%, 52rem);
  }

  .project-prose :global(> p:first-of-type) {
    margin-top: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.4vw, 2.15rem);
    line-height: 1.2;
  }

  .project-prose :global(h3) {
    margin: clamp(4rem, 8vw, 7rem) 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.8vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .project-prose :global(p),
  .project-prose :global(li) {
    font-family: Georgia, serif;
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    line-height: 1.72;
  }

  .project-prose :global(p) {
    margin: 0 0 1.6rem;
  }

  .project-prose :global(ul),
  .project-prose :global(ol) {
    margin: 1.5rem 0 2.5rem;
    padding-left: 1.35rem;
  }

  .project-prose :global(li) {
    margin-bottom: 0.7rem;
    padding-left: 0.35rem;
  }

  .project-prose :global(strong) {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.12em;
  }

  .project-prose :global(pre) {
    max-width: 100%;
    margin: 2.5rem 0;
    padding: 1.4rem;
    overflow-x: auto;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .project-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .project-prose :global(.case-image-link) {
    position: relative;
    display: block;
    width: 100%;
    margin: 2rem 0 0.8rem;
    border: 1px solid var(--ink);
    background: var(--cream-deep);
    overflow: hidden;
  }

  .project-prose :global(.case-image-link img) {
    width: 100%;
    height: auto;
    max-height: 38rem;
    object-fit: contain;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-prose :global(.case-image-link:hover img) {
    transform: scale(1.015);
  }

  .project-prose :global(.case-image-action) {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    padding: 0.45rem 0.6rem;
    background: var(--acid);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    text-transform: uppercase;
  }

  .project-prose :global(.case-inline-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border-bottom: 1px solid var(--orange);
    color: inherit;
  }

  .project-prose :global(div > span) {
    display: block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-align: center;
    text-transform: uppercase;
  }

  .next-project {
    display: block;
    color: var(--case-fg);
    background: var(--case-bg);
  }

  .next-project-inner {
    display: grid;
    min-height: clamp(18rem, 35vw, 34rem);
    align-items: end;
    grid-template-columns: 1fr auto;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .next-project span {
    align-self: start;
    grid-column: 1 / -1;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .next-project strong {
    max-width: 11ch;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 9vw, 9rem);
    letter-spacing: -0.075em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .next-project i {
    font-size: clamp(3rem, 7vw, 7rem);
    font-style: normal;
    transition: transform 250ms ease;
  }

  .next-project:hover i {
    transform: translateX(0.75rem);
  }

  .case-footer {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  @media (max-width: 780px) {
    .case-nav {
      grid-template-columns: 1fr auto;
    }

    .case-nav > span { display: none; }

    h1 {
      font-size: clamp(3.7rem, 17vw, 6.5rem);
      line-height: 0.82;
    }

    .case-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .case-intro > p {
      font-size: 1.35rem;
    }

    .case-external {
      width: fit-content;
    }

    .case-cover-bar { height: 2.2rem; }
    .case-cover img { min-height: 13rem; }

    .case-layout {
      display: block;
      padding-top: 4rem;
      padding-bottom: 6rem;
    }

    .case-rail {
      position: static;
      min-height: auto;
      margin-bottom: 4rem;
      padding: 0.8rem 0;
      flex-direction: row;
      justify-content: space-between;
    }

    .case-rail strong,
    .case-rail p {
      margin: 0;
    }

    .case-rail strong { font-size: 2rem; }
    .case-rail p { text-align: right; }

    .project-prose :global(h3) {
      margin-top: 4rem;
      font-size: clamp(2.2rem, 12vw, 3.4rem);
    }

    .project-prose :global(p),
    .project-prose :global(li) {
      font-size: 1.04rem;
    }

    .project-prose :global(pre) {
      margin-inline: calc(var(--page-gutter) * -1);
      border-right: 0;
      border-left: 0;
      font-size: 0.62rem;
    }

    .next-project-inner {
      min-height: 20rem;
    }

    .case-footer {
      align-items: flex-start;
      padding-top: 1.5rem;
      flex-direction: column;
      justify-content: flex-start;
      gap: 1rem;
    }
  }
</style>
