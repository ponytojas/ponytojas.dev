---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagList from "@/components/ui/TagList.astro";
import { projects } from "@/data/projects";
import { featuredProjects } from "@/data/site";

export function getStaticPaths() {
  return featuredProjects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const slug = Astro.params.slug ?? "";
const project = featuredProjects.find((item) => item.slug === slug);
const detail = projects.find((item) => item.id === slug);

if (!project || !detail) {
  return Astro.redirect("/#work");
}

const currentIndex = featuredProjects.findIndex((item) => item.slug === slug);
const nextProject =
  featuredProjects[(currentIndex + 1) % featuredProjects.length];
const Content = detail.Content;
---

<BaseLayout
  title={`${project.title} — Daniel Villalobos`}
  description={project.description}
>
  <header class="case-header" data-project-tone={project.tone}>
    <nav class="shell case-nav" aria-label="Project navigation">
      <a class="case-home" href="/" aria-label="Daniel Villalobos home">
        Daniel Villalobos
      </a>
      <a href="/#work">← Selected work</a>
      <span
        >{project.number} / {
          String(featuredProjects.length).padStart(2, "0")
        }</span
      >
    </nav>

    <div class="shell case-hero">
      <div class="case-meta">
        <span>{project.category}</span>
        <span>{project.year}</span>
      </div>

      <h1>{project.title}</h1>

      <div class="case-intro">
        <p>{project.description}</p>
        <TagList tags={project.tags} label={`${project.title} technologies`} />
        {
          project.href && (
            <a
              class="case-external"
              href={project.href}
              target="_blank"
              rel="noreferrer"
            >
              {project.cta} <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>

      <button
        class="case-cover"
        type="button"
        data-image-modal
        data-full-src={project.image}
        aria-label={`Open image viewer: ${project.imageAlt}`}
      >
        <div class="case-cover-bar" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <img src={project.image} alt={project.imageAlt} />
      </button>
    </div>
  </header>

  <main class="case-main">
    <div class="shell case-layout">
      <aside class="case-rail">
        <span>Case study</span>
        <strong>{project.number}</strong>
        <p>Read time<br />~6 minutes</p>
      </aside>

      <article class="project-prose">
        <Content />
      </article>
    </div>

    <a
      class="next-project"
      data-project-tone={nextProject.tone}
      href={`/work/${nextProject.slug}`}
    >
      <div class="shell next-project-inner">
        <span>Next project · {nextProject.number}</span>
        <strong>{nextProject.title}</strong>
        <i aria-hidden="true">→</i>
      </div>
    </a>
  </main>

  <footer class="case-footer shell">
    <span>© <span data-year>2026</span> Daniel Villalobos</span>
    <a href="mailto:daniel.villalobosdel@icloud.com">Discuss this project ↗</a>
  </footer>

  <dialog class="image-lightbox" data-image-lightbox aria-label="Image viewer">
    <div class="image-lightbox-toolbar">
      <span data-lightbox-label>Image viewer</span>
      <div class="image-lightbox-controls">
        <button type="button" data-lightbox-zoom-out aria-label="Zoom out">−</button>
        <button type="button" data-lightbox-reset aria-label="Reset zoom">100%</button>
        <button type="button" data-lightbox-zoom-in aria-label="Zoom in">+</button>
        <button type="button" data-lightbox-close aria-label="Close image viewer">Close ×</button>
      </div>
    </div>
    <div class="image-lightbox-stage" data-lightbox-stage>
      <img data-lightbox-image src="" alt="" />
    </div>
  </dialog>
</BaseLayout>

<script>
  let destroyLightbox = () => {};

  const initializeLightbox = () => {
    destroyLightbox();

    const lightbox = document.querySelector<HTMLDialogElement>("[data-image-lightbox]");
    if (!lightbox) return;

    const controller = new AbortController();
    const listenerOptions = { signal: controller.signal };
    destroyLightbox = () => controller.abort();

    const image = lightbox.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const label = lightbox.querySelector<HTMLElement>("[data-lightbox-label]");
    const stage = lightbox.querySelector<HTMLElement>("[data-lightbox-stage]");
    const resetButton = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-reset]");
    let scale = 1;
    let offsetX = 0;
    let offsetY = 0;
    let pointerX = 0;
    let pointerY = 0;
    let dragging = false;

    const renderTransform = () => {
      if (!image || !resetButton) return;
      image.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0) scale(${scale})`;
      image.dataset.zoomed = String(scale > 1);
      resetButton.textContent = `${Math.round(scale * 100)}%`;
    };

    const setZoom = (nextScale: number) => {
      scale = Math.min(4, Math.max(1, nextScale));
      if (scale === 1) {
        offsetX = 0;
        offsetY = 0;
      }
      renderTransform();
    };

    const resetViewer = () => {
      scale = 1;
      offsetX = 0;
      offsetY = 0;
      renderTransform();
    };

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest<HTMLElement>("[data-image-modal]");
      if (!trigger || !image || !label) return;

      const source = trigger.dataset.fullSrc;
      const preview = trigger.querySelector<HTMLImageElement>("img");
      if (!source || !preview) return;

      image.src = source;
      image.alt = preview.alt;
      label.textContent = preview.alt || "Image viewer";
      resetViewer();
      lightbox.showModal();
    }, listenerOptions);

    lightbox.querySelector("[data-lightbox-close]")?.addEventListener("click", () => lightbox.close(), listenerOptions);
    lightbox.querySelector("[data-lightbox-zoom-in]")?.addEventListener("click", () => setZoom(scale + 0.5), listenerOptions);
    lightbox.querySelector("[data-lightbox-zoom-out]")?.addEventListener("click", () => setZoom(scale - 0.5), listenerOptions);
    resetButton?.addEventListener("click", resetViewer, listenerOptions);

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) lightbox.close();
    }, listenerOptions);

    image?.addEventListener("dblclick", () => setZoom(scale > 1 ? 1 : 2), listenerOptions);
    stage?.addEventListener("wheel", (event) => {
      event.preventDefault();
      setZoom(scale + (event.deltaY < 0 ? 0.25 : -0.25));
    }, { ...listenerOptions, passive: false });

    image?.addEventListener("pointerdown", (event) => {
      if (scale === 1) {
        setZoom(2);
        return;
      }
      dragging = true;
      pointerX = event.clientX;
      pointerY = event.clientY;
      image.setPointerCapture(event.pointerId);
    }, listenerOptions);

    image?.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      offsetX += event.clientX - pointerX;
      offsetY += event.clientY - pointerY;
      pointerX = event.clientX;
      pointerY = event.clientY;
      renderTransform();
    }, listenerOptions);

    const stopDragging = (event: PointerEvent) => {
      dragging = false;
      if (image?.hasPointerCapture(event.pointerId)) {
        image.releasePointerCapture(event.pointerId);
      }
    };

    image?.addEventListener("pointerup", stopDragging, listenerOptions);
    image?.addEventListener("pointercancel", stopDragging, listenerOptions);

    lightbox.addEventListener("close", resetViewer, listenerOptions);
  };

  initializeLightbox();
  document.addEventListener("astro:page-load", initializeLightbox);
</script>

<style>
  :global(body) {
    background: var(--cream);
  }

  .case-header {
    padding-bottom: clamp(3rem, 7vw, 7rem);
    color: var(--project-tone-fg);
    background: var(--project-tone-bg);
  }

  .case-nav {
    display: grid;
    min-height: 5.5rem;
    align-items: center;
    grid-template-columns: 1fr auto 1fr;
    border-bottom: 1px solid currentColor;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .case-nav > span {
    justify-self: end;
  }

  .case-home {
    justify-self: start;
    letter-spacing: 0.02em;
  }

  .case-hero {
    padding-top: clamp(2.5rem, 6vw, 6rem);
  }

  .case-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: clamp(2rem, 5vw, 5rem) 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 12vw, 12rem);
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.78;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .case-intro {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(18rem, 1.4fr) 1fr auto;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .case-intro > p {
    max-width: 46ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.3vw, 2.15rem);
    line-height: 1.12;
  }

  .case-external {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .case-cover {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--ink);
    background: #f7f4ec;
    color: var(--ink);
    cursor: zoom-in;
    text-align: initial;
  }

  .case-cover-bar {
    display: flex;
    height: 2.7rem;
    align-items: center;
    gap: 0.45rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .case-cover-bar span {
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .case-cover-bar small {
    margin-left: auto;
    font-size: 0.55rem;
  }

  .case-cover img {
    width: 100%;
    max-height: 48rem;
    object-fit: cover;
    object-position: top center;
  }

  .case-main {
    background: var(--cream);
  }

  .case-layout {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(5rem, 12vw, 12rem);
  }

  .case-rail {
    position: sticky;
    top: 2rem;
    display: flex;
    min-height: 18rem;
    padding: 1rem 0;
    flex-direction: column;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .case-rail strong {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 8rem);
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .case-rail p {
    margin: auto 0 0;
    line-height: 1.5;
  }

  .project-prose {
    width: min(100%, 52rem);
  }

  .project-prose :global(> p:first-of-type) {
    margin-top: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.4vw, 2.15rem);
    line-height: 1.2;
  }

  .project-prose :global(h3) {
    margin: clamp(4rem, 8vw, 7rem) 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.8vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .project-prose :global(p),
  .project-prose :global(li) {
    font-family: Georgia, serif;
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    line-height: 1.72;
  }

  .project-prose :global(p) {
    margin: 0 0 1.6rem;
  }

  .project-prose :global(ul),
  .project-prose :global(ol) {
    margin: 1.5rem 0 2.5rem;
    padding-left: 1.35rem;
  }

  .project-prose :global(li) {
    margin-bottom: 0.7rem;
    padding-left: 0.35rem;
  }

  .project-prose :global(strong) {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.12em;
  }

  .project-prose :global(pre) {
    max-width: 100%;
    margin: 2.5rem 0;
    padding: 1.4rem;
    overflow-x: auto;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .project-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .project-prose :global(.case-image-link) {
    position: relative;
    display: block;
    width: 100%;
    margin: 2rem 0 0.8rem;
    border: 1px solid var(--ink);
    background: var(--cream-deep);
    color: var(--ink);
    cursor: zoom-in;
    overflow: hidden;
    padding: 0;
    text-align: initial;
  }

  .project-prose :global(.case-image-link img) {
    width: 100%;
    height: auto;
    max-height: 38rem;
    object-fit: contain;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-prose :global(.case-image-link:hover img) {
    transform: scale(1.015);
  }

  .project-prose :global(.case-image-action) {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    padding: 0.45rem 0.6rem;
    background: var(--acid);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    text-transform: uppercase;
  }

  .image-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(23, 23, 20, 0.96);
    color: var(--cream);
    overflow: hidden;
  }

  .image-lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .image-lightbox::backdrop {
    background: rgba(23, 23, 20, 0.82);
  }

  .image-lightbox-toolbar {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem var(--page-gutter);
    border-bottom: 1px solid rgba(242, 238, 227, 0.35);
    background: var(--ink);
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .image-lightbox-toolbar > span {
    max-width: min(42rem, 48vw);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .image-lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .image-lightbox-controls button {
    min-width: 2.3rem;
    min-height: 2.3rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .image-lightbox-controls button:hover,
  .image-lightbox-controls button:focus-visible {
    background: var(--acid);
    color: var(--ink);
  }

  .image-lightbox-stage {
    display: grid;
    min-height: 0;
    place-items: center;
    padding: clamp(1rem, 3vw, 3rem);
    overflow: hidden;
    touch-action: none;
  }

  .image-lightbox-stage img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    cursor: zoom-in;
    object-fit: contain;
    transform-origin: center;
    transition: transform 180ms ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  .image-lightbox-stage img[data-zoomed="true"] {
    cursor: grab;
  }

  .image-lightbox-stage img[data-zoomed="true"]:active {
    cursor: grabbing;
    transition: none;
  }

  @media (max-width: 42rem) {
    .image-lightbox-toolbar {
      justify-content: flex-end;
      padding-inline: 0.75rem;
    }

    .image-lightbox-toolbar > span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .image-lightbox-controls {
      width: 100%;
      justify-content: flex-end;
    }

    .image-lightbox-controls button {
      padding-inline: 0.55rem;
    }

    .image-lightbox-controls [data-lightbox-close] {
      margin-left: auto;
    }
  }

  .project-prose :global(.case-inline-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border-bottom: 1px solid var(--orange);
    color: inherit;
  }

  .project-prose :global(div > span) {
    display: block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-align: center;
    text-transform: uppercase;
  }

  .next-project {
    display: block;
    color: var(--project-tone-fg);
    background: var(--project-tone-bg);
  }

  .next-project-inner {
    display: grid;
    min-height: clamp(18rem, 35vw, 34rem);
    align-items: end;
    grid-template-columns: 1fr auto;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .next-project span {
    align-self: start;
    grid-column: 1 / -1;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .next-project strong {
    max-width: 11ch;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 9vw, 9rem);
    letter-spacing: -0.075em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .next-project i {
    font-size: clamp(3rem, 7vw, 7rem);
    font-style: normal;
    transition: transform 250ms ease;
  }

  .next-project:hover i {
    transform: translateX(0.75rem);
  }

  .case-footer {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  @media (max-width: 780px) {
    .case-nav {
      grid-template-columns: 1fr auto;
    }

    .case-nav > span {
      display: none;
    }

    h1 {
      font-size: clamp(3.7rem, 17vw, 6.5rem);
      line-height: 0.82;
    }

    .case-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .case-intro > p {
      font-size: 1.35rem;
    }

    .case-external {
      width: fit-content;
    }

    .case-cover-bar {
      height: 2.2rem;
    }
    .case-cover img {
      min-height: 13rem;
    }

    .case-layout {
      display: block;
      padding-top: 4rem;
      padding-bottom: 6rem;
    }

    .case-rail {
      position: static;
      min-height: auto;
      margin-bottom: 4rem;
      padding: 0.8rem 0;
      flex-direction: row;
      justify-content: space-between;
    }

    .case-rail strong,
    .case-rail p {
      margin: 0;
    }

    .case-rail strong {
      font-size: 2rem;
    }
    .case-rail p {
      text-align: right;
    }

    .project-prose :global(h3) {
      margin-top: 4rem;
      font-size: clamp(2.2rem, 12vw, 3.4rem);
    }

    .project-prose :global(p),
    .project-prose :global(li) {
      font-size: 1.04rem;
    }

    .project-prose :global(pre) {
      margin-inline: calc(var(--page-gutter) * -1);
      border-right: 0;
      border-left: 0;
      font-size: 0.62rem;
    }

    .next-project-inner {
      min-height: 20rem;
    }

    .case-footer {
      align-items: flex-start;
      padding-top: 1.5rem;
      flex-direction: column;
      justify-content: flex-start;
      gap: 1rem;
    }
  }
</style>
