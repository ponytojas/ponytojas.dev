---
import SiteLayout from "@/layouts/SiteLayout.astro";
import BlogList from "@/components/site/BlogList.astro";
import { getAllBlogPosts } from "@/data/blog";

const posts = getAllBlogPosts().map(({ slug, title, date, excerpt, readTime, tags }) => ({
  slug,
  title,
  date,
  excerpt,
  readTime,
  tags,
}));
---

<SiteLayout title="Writing | Daniel Villalobos" description="Blog posts by Daniel Villalobos">
  <div class="py-16 md:py-24">
    <header class="container-custom mb-12 md:mb-20">
      <p class="meta-label mb-6 text-reveal" data-text-reveal>Writing</p>
      <h1
        class="display-type text-[clamp(3rem,9vw,8rem)] text-reveal"
        style="--reveal-delay: 80ms;"
        data-text-reveal
      >
        Notes &amp; <span class="serif-accent text-accent">essays</span>
      </h1>
      <p
        class="serif-accent mt-8 max-w-2xl text-xl md:text-2xl text-muted-foreground text-pretty text-reveal"
        style="--reveal-delay: 150ms;"
        data-text-reveal
      >
        On engineering, product thinking, and the small details that make software feel calm and dependable.
      </p>
    </header>

    <div class="container-custom">
      <BlogList posts={posts} />
    </div>
  </div>
</SiteLayout>
