---
import SiteLayout from "@/layouts/SiteLayout.astro";
import BlogList from "@/components/site/BlogList.astro";
import { getLatestBlogPosts } from "@/data/blog";
import { experiences } from "@/data/experiences";
import { projects } from "@/data/projects";

const posts = getLatestBlogPosts(3).map(({ slug, title, date, excerpt, readTime, tags }) => ({
  slug,
  title,
  date,
  excerpt,
  readTime,
  tags,
}));

const featuredExperiences = experiences.slice(0, 4);
---

<SiteLayout>
  <section class="container-custom flex min-h-[calc(100dvh-4rem)] flex-col justify-end pb-14 md:pb-20">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 mb-10 text-reveal" data-text-reveal>
      <p class="meta-label">Software engineer</p>
      <p class="meta-label">Based in Spain</p>
      <p class="meta-label">Distributed systems &amp; geospatial data</p>
    </div>

    <h1
      class="display-type text-[clamp(2.75rem,10.5vw,10rem)] text-reveal"
      style="--reveal-delay: 80ms;"
      data-text-reveal
    >
      Daniel<br />Villalobos
    </h1>

    <p
      class="serif-accent mt-8 max-w-3xl text-2xl md:text-4xl leading-snug text-pretty text-reveal"
      style="--reveal-delay: 160ms;"
      data-text-reveal
    >
      Software that holds up in the real world &mdash; less about boxes and arrows,
      more about how systems fail without taking everything down.
    </p>
  </section>

  <section class="border-t border-border">
    <div class="container-custom py-16 md:py-24">
      <div class="flex items-baseline justify-between gap-6 mb-10 md:mb-14">
        <h2 class="meta-label text-reveal" data-text-reveal>01 &mdash; Experience</h2>
        <a href="/experience" class="link-line meta-label hover:text-foreground transition-colors">All experience</a>
      </div>

      <div class="index-list border-t border-border">
        {
          featuredExperiences.map(({ metadata }) => (
            <a href="/experience" class="index-row group block border-b border-border py-7 md:py-9">
              <div class="grid grid-cols-1 md:grid-cols-[10rem_1fr_auto] gap-2 md:gap-10 items-baseline">
                <span class="meta-label tabular-nums">{metadata.time}</span>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 min-w-0">
                  <h3 class="display-type text-2xl md:text-4xl group-hover:text-accent transition-colors">
                    {metadata.title}
                  </h3>
                  <p class="serif-accent text-lg md:text-xl text-muted-foreground">{metadata.position}</p>
                </div>
                <span class="row-arrow hidden md:block text-2xl" aria-hidden="true">
                  &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="container-custom py-16 md:py-24">
      <div class="flex items-baseline justify-between gap-6 mb-10 md:mb-14">
        <h2 class="meta-label text-reveal" data-text-reveal>02 &mdash; Projects</h2>
        <a href="/projects" class="link-line meta-label hover:text-foreground transition-colors">All projects</a>
      </div>

      <div class="index-list border-t border-border">
        {
          projects.map(({ metadata }) => (
            <a href="/projects" class="index-row group block border-b border-border py-7 md:py-9">
              <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-2 md:gap-10 items-baseline">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 min-w-0">
                  <h3 class="display-type text-2xl md:text-4xl group-hover:text-accent transition-colors">
                    {metadata.title}
                  </h3>
                  {metadata.subtitle ? (
                    <p class="serif-accent text-lg md:text-xl text-muted-foreground">{metadata.subtitle}</p>
                  ) : null}
                </div>
                <span class="row-arrow hidden md:block text-2xl" aria-hidden="true">
                  &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="container-custom py-16 md:py-24">
      <div class="flex items-baseline justify-between gap-6 mb-10 md:mb-14">
        <h2 class="meta-label text-reveal" data-text-reveal>03 &mdash; Writing</h2>
        <a href="/blog" class="link-line meta-label hover:text-foreground transition-colors">All posts</a>
      </div>

      <BlogList posts={posts} />
    </div>
  </section>
</SiteLayout>
